# ─────────────────────────────────────────────────────────────────────────────
# AgenThink Mesh — On-Premises Environment Template
# Sprint 3 WP-9
#
# Copy this file to .env and fill in all required values before starting.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (TiDB / MySQL 8) ─────────────────────────────────────────────────
# Format: mysql2://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"rejectUnauthorized":true}
DATABASE_URL=mysql2://root:CHANGE_ME@localhost:4000/agenthinkmesh

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im/login

# ── Manus App Identity ────────────────────────────────────────────────────────
VITE_APP_ID=CHANGE_ME_APP_ID
OWNER_OPEN_ID=CHANGE_ME_OWNER_OPEN_ID
OWNER_NAME=CHANGE_ME_OWNER_NAME

# ── Built-in Forge API (LLM, Storage, Notifications) ─────────────────────────
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=CHANGE_ME_FORGE_API_KEY
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=CHANGE_ME_FRONTEND_FORGE_API_KEY

# ── LLM Provider Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
GOOGLE_API_KEY=CHANGE_ME_GOOGLE_API_KEY
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
ENABLE_DEEPSEEK_ROUTING=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY

# ── Stripe Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET
VITE_STRIPE_PUBLISHABLE_KEY=CHANGE_ME_STRIPE_PUBLISHABLE_KEY

# ── Microsoft Graph (email integration) ──────────────────────────────────────
MS_CLIENT_ID=CHANGE_ME_MS_CLIENT_ID
MS_CLIENT_SECRET=CHANGE_ME_MS_CLIENT_SECRET
MS_TENANT_ID=CHANGE_ME_MS_TENANT_ID

# ── News API ──────────────────────────────────────────────────────────────────
NEWS_API_KEY=CHANGE_ME_NEWS_API_KEY

# ── Rate Limiting & Cost Controls ────────────────────────────────────────────
DAILY_API_SPEND_CAP=50
MAX_RUNS_PER_HOUR=100
FLEET_COST_ALERT_THRESHOLD_USD=10

# ── Encryption ────────────────────────────────────────────────────────────────
DATA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX
ENCRYPTION_MASTER_KEY=CHANGE_ME_32_BYTE_HEX

# ── Analytics (optional) ─────────────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── Scheduler (Heartbeat) ─────────────────────────────────────────────────────
SCHEDULER_SECRET=CHANGE_ME_SCHEDULER_SECRET

# ── Misc ──────────────────────────────────────────────────────────────────────
VITE_APP_TITLE=AgenThink Mesh
VITE_APP_LOGO=
VITE_WEB3FORMS_ACCESS_KEY=
WEB3FORMS_ACCESS_KEY=
ENABLE_INTERNAL_SCREEN_API=false
